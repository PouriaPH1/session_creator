# Telegram API Credentials
# Get these from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Master OTP Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_URL=http://127.0.0.1:8000

# Set panel credentials locally with: python -m cli.admin_auth
# Remote panel access requires HTTPS. HTTP loopback/SSH tunnels are supported.
ADMIN_ALLOW_INSECURE_HTTP=false
# Worker machines only. Generate a token in the authenticated panel settings.
WORKER_API_TOKEN=

# Storage Paths
SOURCE_SESSIONS_DIR=storage/source_sessions
TARGET_SESSIONS_DIR=storage/target_sessions

# Migration Timing (Seconds)
OTP_POLL_TIMEOUT=60
OTP_POLL_INTERVAL=2.5
BATCH_SLEEP_DELAY=15.0
